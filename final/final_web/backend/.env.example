# Environment variables template
# Copy this file to .env and fill in your values

# HuggingFace API Token (optional, for API-based inference)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Model paths (optional, defaults will be used if not set)
# MMDET_CONFIG_PATH=models/faster_rcnn_r50_fpn_1x_coco.py
# MMDET_CHECKPOINT_PATH=models/faster_rcnn_r50_fpn_1x_coco_20200130-047c8118.pth

# LLM Model selection
# Options: gpt2, gpt2-medium, flan-t5, bloom, recipe-nlg, mistral, llama2
LLM_MODEL_NAME=flan-t5

# Use HuggingFace API instead of local model (true/false)
USE_HUGGINGFACE_API=false

# Server Configuration
API_HOST=0.0.0.0
API_PORT=5000
